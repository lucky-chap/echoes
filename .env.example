# Server-only. Never prefix this with NEXT_PUBLIC_.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TIMEOUT_MS=7000
# Required to independently verify movie and TV release years. Keep server-only.
TMDB_API_KEY=
# Optional: server-only intake extraction. Session notes are drafted from observations without an LLM.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Protected single-site pilot (all required). Use HTTPS outside localhost.
# Generate a 32-byte hex encryption key with: openssl rand -hex 32
# Use a unique caregiver passphrase of at least 12 characters; never commit values.
ECHOES_STORAGE_KEY=
ECHOES_CAREGIVER_CODE=
ECHOES_ORIGIN=
# Absolute path on a durable, backed-up volume. Not an ephemeral/serverless filesystem.
ECHOES_DATA_DIR=

# MusicBrainz requires an identifiable contact for its 1 request/second client.
MUSICBRAINZ_CONTACT_EMAIL=
# Read real cached provider responses first; bound live cache misses to 12s per kit.
DEMO_MODE=false
# Optional durable JSON response cache (defaults to .echoes-data/provider-cache).
ECHOES_CACHE_DIR=
