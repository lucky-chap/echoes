GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_PROVIDER=groq
MAX_LLM_CALLS_PER_SESSION=10
# Confirm in the Groq console that this account is on the Free Plan.
GROQ_FREE_PLAN_CONFIRMED=false
# Set these BELOW your account-specific available free limits (including other apps).
GROQ_DAILY_REQUEST_LIMIT=20
GROQ_REQUESTS_PER_MINUTE=2
GROQ_TOKENS_PER_MINUTE=20000
GROQ_DAILY_TOKEN_LIMIT=60000
# Public Groq live mode is OFF unless BOTH are set for one persistent server.
# WORLDLINGS_SINGLE_INSTANCE=true
# WORLDLINGS_QUOTA_DIR=/absolute/path/on/persistent/volume
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TIMEOUT_MS=7000
